        },
        "semantic_effect_id": {
          "minLength": 1,
          "title": "Semantic Effect Id",
          "type": "string"
        },
        "target_entity_id": {
          "minLength": 1,
          "title": "Target Entity Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        }
