        },
        "reference_detection_id": {
          "minLength": 1,
          "title": "Reference Detection Id",
          "type": "string"
        },
        "reference_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "sha256:[0-9a-f]{64}",
          "title": "Reference Digest",
          "type": "string"
        },
        "reference_frame_id": {
          "minLength": 1,
          "title": "Reference Frame Id",
          "type": "string"
        },
        "reference_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TwoButtonObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
